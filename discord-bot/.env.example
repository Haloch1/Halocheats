# ============================================
# Discord Channel Mirror - Dynamic Channel Mirroring
# ============================================
# Most configuration has been moved to config.json
# Only the sensitive token remains here

# ============================================
# REQUIRED SETTINGS
# ============================================

# Your Discord token (REQUIRED)
TOKEN=your_discord_token_here

# ============================================
# CONFIGURATION
# ============================================
# All other settings are now in config.json:
# - targetGuildId (target server)
# - channels (source channels to monitor)
# - modes (fullServerCopy, autoCreateChannels)
# - categorySettings (targetCategoryId, copyCategoryStructure)
# - botSettings (username)
# - sourceGuildId (for full server copy mode)
# - loopMessage (re-copy one specific message on an interval)
#
# Edit config.json to change settings - hot reload supported!
# See config.json.example for format

# ============================================
# LEGACY SUPPORT (.env fallback)
# ============================================
# If config.json doesn't exist, bot will use these .env values:
# TARGET_GUILD_ID=
# CHANNEL_1=
# CHANNEL_2=
# FULL_SERVER_COPY=false
# AUTO_CREATE_CHANNELS=true
# SOURCE_GUILD_ID=
# BOT_USERNAME=Bot
# TARGET_CATEGORY_ID=
# COPY_CATEGORY_STRUCTURE=false
