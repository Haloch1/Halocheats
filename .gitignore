# Env files: ignore all variants, keep only the example
.env
.env.*
!.env.example
node_modules/
*.log
__pycache__/
*.pyc
logs/
src/**/__pycache__/
build/
dist/
*.spec

# Never commit key inventories or PDFs
Halo Cheats - Key Inventory.pdf
*.pdf

# Local-only working files - never belong in the deployed repo
_workspace-extras/
tools/stripe-refund-tool/
CODEX-PROMPT.txt
